{
  "name": "zzz-build-panel",
  "version": "0.1.0",
  "description": "绝区零养成指南 —— 本地服务器 + 米游社 wiki/账号数据同步 + 前端配装分析",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy server.js",
    "sync:library": "node src/sync/library.js",
    "sync:characters": "node src/sync/characters.js",
    "sync:plans": "node src/sync/plans.js",
    "sync:workshop": "node --use-env-proxy scripts/workshop-cli.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,md,json}\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jimp": "^1.6.1",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "subset-font": "^2.5.0"
  }
}
